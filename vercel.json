{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "server.js": {
      "includeFiles": "**"
    }
  },
  "rewrites": [
    { "source": "/api/bookings/:id", "destination": "/api/bookings?id=:id" },
    { "source": "/book-service", "destination": "/book-service.html" }
  ]
}
